{
  "name": "carelink",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "device:provision": "node --env-file=.env.provisioning.local scripts/provision-device.mjs",
    "device:simulate": "node --env-file=.env.simulator.local scripts/device-simulator.mjs",
    "format": "prettier --write src tests *.ts *.json *.js index.html README.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/vite": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
